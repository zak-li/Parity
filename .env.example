XI_HTTP_TIMEOUT_SECONDS=10.0
XI_HTTP_MAX_RETRIES=3
XI_HTTP_BACKOFF_FACTOR=0.5
XI_HTTP_MAX_RESPONSE_BYTES=2000000
XI_CACHE_TTL_SECONDS=3600.0
XI_CACHE_MAX_ENTRIES=256
XI_RATE_LIMIT_PER_SECOND=10.0
XI_RATE_LIMIT_BURST=20
XI_ALLOWED_FX_HOSTS=api.frankfurter.dev

# API (optional) - master key; when set, the X-API-Key header becomes mandatory
XI_API_KEY=

# Secret pepper for per-client API-key hashing (REQUIRED in production for `api.keys`)
XI_API_KEY_PEPPER=

# Redis (optional) - shared cache + rate limiter for multi-worker deployments
XI_REDIS_URL=

# Inbound request guards (optional) - per-client rate limit, concurrency, timeout
XI_API_RATE_LIMIT_PER_SECOND=25
XI_API_RATE_LIMIT_BURST=50
XI_API_MAX_CONCURRENCY=8
XI_API_REQUEST_TIMEOUT_SECONDS=30

# Observability (optional) - JSON log level
XI_LOG_LEVEL=INFO

# Persistence (optional) - leave empty to use in-memory storage
# Set XI_DB_AUTO_CREATE=0 in production and manage the schema with `alembic upgrade head`.
XI_DB_AUTO_CREATE=1
XI_POSTGRES_DSN=
XI_MONGODB_URI=
XI_MONGODB_DATABASE=xi
XI_NEO4J_URI=
XI_NEO4J_USERNAME=
XI_NEO4J_PASSWORD=
XI_NEO4J_DATABASE=neo4j

# AI (optional) - Groq narrative
XI_GROQ_API_KEY=
XI_GROQ_MODEL=llama-3.3-70b-versatile

# SSO (optional) - Auth0
XI_AUTH0_DOMAIN=
XI_AUTH0_CLIENT_ID=
XI_AUTH0_AUDIENCE=api://default

# CORS (optional) - comma-separated browser origins allowed to call the API.
# Leave empty to disable CORS. Example: XI_CORS_ALLOW_ORIGINS=http://localhost:4200
XI_CORS_ALLOW_ORIGINS=

# MLflow (optional) - experiment tracking of simulation runs. Requires the
# `[mlflow]` extra. Leave the tracking URI empty to disable (no-op tracker).
# Examples: file:./mlruns  |  http://mlflow-server:5000
XI_MLFLOW_TRACKING_URI=
XI_MLFLOW_EXPERIMENT=parity-simulations

# Apache Spark (optional) - master for the batch simulation job
# (`python -m core.app.distributed`). Requires the `[spark]` extra + a JVM.
XI_SPARK_MASTER=local[*]
